# Copy this file to .env and fill in the values: cp .env.example .env

# Django secret key. Generate a new one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-django-secret-key

# True for local development, False in production
DEBUG=True

# Comma-separated hosts the server answers to
ALLOWED_HOSTS=localhost,127.0.0.1

# Get a new one at https://aistudio.google.com/api-keys or ask us for a production key
GEMINI_API_KEY=your-gemini-api-key